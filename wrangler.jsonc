{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comocontentcreator",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }

  // ─── REAL DOMAIN ────────────────────────────────────────────────────────
  // comocontentcreator.com currently uses Squarespace's nameservers
  // (ns-cloud-e1..e4.googledomains.com) and points at Squarespace's servers.
  // A Workers custom domain only works once the zone lives in Cloudflare, so:
  //
  //   1. Cloudflare dashboard -> Add a site -> comocontentcreator.com (Free).
  //   2. Copy the two nameservers Cloudflare gives you.
  //   3. Squarespace domain settings -> Nameservers -> custom -> paste them.
  //   4. Wait until Cloudflare shows the site as "Active" (usually minutes,
  //      up to 24h).
  //   5. Add a comma after the "observability" block above, then paste the
  //      block below in its place, and run `npm run cf:deploy`. Wrangler
  //      creates the DNS records and the HTTPS certificate itself.
  //
  // "routes": [
  //   { "pattern": "comocontentcreator.com", "custom_domain": true },
  //   { "pattern": "www.comocontentcreator.com", "custom_domain": true }
  // ]
}
